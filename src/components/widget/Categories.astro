---
import { getCategoryList } from "../../utils/content-utils";
import { getCategoryUrl } from "../../utils/url-utils";

const categories = await getCategoryList();
const MAX_VISIBLE = 5;
const visibleCategories = categories.slice(0, MAX_VISIBLE);
const extraCategories = categories.slice(MAX_VISIBLE);
const hasMore = extraCategories.length > 0;

interface Props {
	class?: string;
	style?: string;
	collapsible?: boolean;
}
const { class: className, style } = Astro.props;
---

<div class:list={["flex flex-col", className]} style={style}>
	{visibleCategories.map((c) => (
		<a
			href={getCategoryUrl(c.name.trim())}
			class="category-item"
			aria-label={`查看分类「${c.name.trim()}」下的所有文章`}
		>
			<span class="category-name">{c.name.trim()}</span>
			<span class="category-count">{c.count}</span>
		</a>
	))}

	{hasMore && (
		<>
			<div class="category-extra">
				{extraCategories.map((c) => (
					<a
						href={getCategoryUrl(c.name.trim())}
						class="category-item"
						aria-label={`查看分类「${c.name.trim()}」下的所有文章`}
					>
						<span class="category-name">{c.name.trim()}</span>
						<span class="category-count">{c.count}</span>
					</a>
				))}
			</div>
			<button type="button" class="category-toggle" data-expanded="false" aria-expanded="false">
				<span class="category-toggle-label">展开全部</span>
				<svg class="category-toggle-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M6 9l6 6 6-6" />
				</svg>
			</button>
		</>
	)}
</div>

<style>
	.category-item {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 0.4rem 0.625rem;
		border-radius: 0.625rem;
		transition: background 0.2s ease;
	}

	.category-item:hover {
		background: var(--tint-20);
	}

	.category-name {
		flex: 1;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		font-size: 0.875rem;
		color: var(--accent-text);
		transition: color 0.2s ease;
	}

	.category-item:hover .category-name {
		color: var(--secondary);
	}

	.category-count {
		flex-shrink: 0;
		min-width: 1.375rem;
		padding: 0.0625rem 0.5rem;
		border-radius: 999px;
		background: var(--tint-15);
		color: var(--accent-text);
		font-size: 0.6875rem;
		font-weight: 600;
		text-align: center;
		line-height: 1.4;
		transition: background 0.2s ease, color 0.2s ease;
	}

	.category-item:hover .category-count {
		background: var(--tint-30);
		color: var(--secondary);
	}

	.category-extra {
		display: none;
		flex-direction: column;
		gap: 0.375rem;
	}

	.category-extra.is-open {
		display: flex;
	}

	.category-toggle {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.25rem;
		margin-top: 0.375rem;
		padding: 0.375rem;
		border: none;
		border-radius: 0.5rem;
		background: transparent;
		cursor: pointer;
		color: var(--text-secondary);
		font-size: 0.8125rem;
		transition: color 0.2s ease, background 0.2s ease;
	}

	.category-toggle:hover {
		color: var(--accent-text);
		background: var(--tint-10);
	}

	.category-toggle-icon {
		width: 0.875rem;
		height: 0.875rem;
		transition: transform 0.25s ease;
	}

	.category-toggle[data-expanded="true"] .category-toggle-icon {
		transform: rotate(180deg);
	}

	@media (max-width: 768px) {
		.category-item {
			padding: 0.375rem 0.5rem;
		}

		.category-name {
			font-size: 0.8125rem;
		}

		.category-count {
			font-size: 0.625rem;
		}
	}
</style>

<script is:inline>
	function initCategoryToggle() {
		document.querySelectorAll(".category-toggle").forEach((btn) => {
			if (btn.dataset.bound === "true") return;
			btn.dataset.bound = "true";

			const extra = btn.parentElement?.querySelector(".category-extra");
			const label = btn.querySelector(".category-toggle-label");

			btn.addEventListener("click", () => {
				const expanded = btn.dataset.expanded === "true";
				btn.dataset.expanded = String(!expanded);
				btn.setAttribute("aria-expanded", String(!expanded));
				if (extra) extra.classList.toggle("is-open", !expanded);
				if (label) label.textContent = expanded ? "展开全部" : "收起";
			});
		});
	}

	document.addEventListener("astro:page-load", initCategoryToggle);
	if (document.readyState !== "loading") initCategoryToggle();
</script>
