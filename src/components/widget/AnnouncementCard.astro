---
import ImageWrapper from "@components/misc/ImageWrapper.astro";

interface Props {
	title: string;
	content: string;
	avatar: string;
}

const { title, content, avatar } = Astro.props;
---

<div class="bg-tint-10 glass-surface rounded-2xl shadow-xl p-4" data-announcement-card>
	<div class="flex items-start gap-4">
		<div class="flex-shrink-0">
			<ImageWrapper
				src={avatar}
				alt="公告头像"
				class="w-12 h-12 rounded-full object-cover border-2 border-[color-mix(in_srgb,var(--primary)_25%,transparent)]"
				loading="lazy"
			/>
		</div>
		<div class="flex-1">
			<p class="font-bold text-accent">{title}：</p>
			<p class="text-gray-600 dark:text-gray-300">{content}</p>
		</div>
	</div>
</div>
