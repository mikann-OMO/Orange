---
import { Icon } from "astro-icon/components";

interface Props {
	name: string;
	avatar: string;
	url: string;
	description: string;
	tags: string[];
}

const { name, avatar, url, description, tags } = Astro.props;
---

<a
	href={url}
	target="_blank"
	rel="noopener noreferrer"
	class="tool-card"
	aria-label={`访问 ${name}`}
>
	<div class="tool-card-head">
		<img
			src={avatar}
			alt=""
			aria-hidden="true"
			class="tool-avatar"
			loading="lazy"
			decoding="async"
			onerror="this.style.display='none'"
		/>
		<h3 class="tool-name">{name}</h3>
		<Icon
			name="fa6-solid:arrow-up-right-from-square"
			class="tool-external"
			aria-hidden="true"
		/>
	</div>
	<p class="tool-desc">{description}</p>
	{tags.length > 0 && (
		<div class="tool-tags">
			{tags.map((tag) => (
				<span class="tool-tag">{tag}</span>
			))}
		</div>
	)}
</a>

<style>
.tool-card {
	display: flex;
	flex-direction: column;
	gap: 12px;
	padding: 20px;
	background: var(--card-bg);
	border: 1px solid var(--card-border);
	border-radius: 14px;
	box-shadow: 0 4px 20px var(--shadow-color);
	text-decoration: none;
	color: inherit;
	transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
}

.tool-card:hover {
	transform: translateY(-3px);
	border-color: color-mix(in srgb, var(--primary) 40%, transparent);
	box-shadow: 0 10px 28px color-mix(in srgb, var(--primary) 18%, var(--shadow-color));
}

.tool-card:active {
	transform: translateY(-1px) scale(0.99);
}

.tool-card:focus-visible {
	outline: 2px solid var(--primary);
	outline-offset: 3px;
}

.tool-card-head {
	display: flex;
	align-items: center;
	gap: 12px;
	min-width: 0;
}

.tool-avatar {
	width: 48px;
	height: 48px;
	border-radius: 12px;
	object-fit: cover;
	flex-shrink: 0;
	background: var(--tint-15);
	border: 1px solid var(--card-border);
	box-shadow: 0 2px 8px var(--shadow-color);
}

.tool-name {
	flex: 1;
	min-width: 0;
	margin: 0;
	font-size: 1.0625rem;
	font-weight: 700;
	color: var(--text-primary);
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.tool-external {
	flex-shrink: 0;
	font-size: 0.875rem;
	color: var(--text-secondary);
	opacity: 0.6;
	transition: color 0.25s ease, opacity 0.25s ease, transform 0.25s ease;
}

.tool-card:hover .tool-external {
	color: var(--primary);
	opacity: 1;
	transform: translate(1px, -1px);
}

.tool-desc {
	margin: 0;
	font-size: 0.875rem;
	line-height: 1.6;
	color: var(--text-secondary);
	display: -webkit-box;
	-webkit-line-clamp: 2;
	-webkit-box-orient: vertical;
	overflow: hidden;
}

.tool-tags {
	display: flex;
	flex-wrap: wrap;
	gap: 6px;
	margin-top: auto;
}

.tool-tag {
	font-size: 0.6875rem;
	line-height: 1;
	padding: 5px 10px;
	border-radius: 999px;
	background: var(--tint-15);
	color: var(--accent-text);
	border: 1px solid var(--card-border);
	transition: background 0.2s ease, color 0.2s ease;
}

.tool-card:hover .tool-tag {
	background: color-mix(in srgb, var(--primary) 12%, transparent);
}
</style>
