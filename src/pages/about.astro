		url: "https://www.xiaohongshu.com/user/profile/6667f50a0000000003032ab1?xsec_token=YBe5ry2-JQjNPsk4l9XQFFHRAJ4PtCFOiy8J6-ou7Zt7c%3D&xsec_source=app_share&xhsshare=&shareRedId=ODhHQzM1ODw2NzUyOTgwNjdIOThJPjpM&apptime=1782370797&share_id=14c2d2e96f284b889519ed5db30b4543&share_channel=qq",
	},
];
---
<MainGridLayout title={i18n(I18nKey.about)} description={i18n(I18nKey.about)}>
    <div class="bg-tint-10 rounded-2xl md:rounded-none shadow-xl p-4 md:p-6 border border-[var(--card-border)] md:border-0 card-enter">
        <div class="flex flex-row items-center md:items-start gap-4 md:gap-6">
            <div class="flex-shrink-0">
                <Profile class="max-w-md"></Profile>
            </div>
            <div class="flex-1 text-left">
                <h1 class="text-xl md:text-2xl font-bold mb-1 md:mb-2 text-[var(--accent-text)] dark:text-white">{profileConfig.name}</h1>
                <p class="text-sm md:text-base text-muted mb-3 md:mb-4">{profileConfig.bio}</p>
                <div class="flex flex-row flex-wrap gap-2 md:gap-3 justify-start">
                    <a href="https://github.com/mikann-OMO" target="_blank" rel="noopener noreferrer" class="btn-surface rounded-lg px-3 md:px-4 py-1.5 md:py-2 text-sm" aria-label="GitHub">
                        <Icon name="fa6-brands:github" class="text-[1rem]" />
                        <span>GitHub</span>
                    </a>
                    {platformLinks.map((platform) => (
                        <a
                            href={platform.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="btn-icon rounded-lg w-8 md:w-10 h-8 md:h-10 text-sm"
                            aria-label={platform.name}
                            title={platform.name}
                        >
                            {platform.svg ? (
                                <svg viewBox="0 0 24 24" class="w-4 h-4" aria-hidden="true" set:html={platform.svg}></svg>
                            ) : (
                                <Icon name={platform.icon} class="text-[1rem]" />
                            )}
                        </a>
                    ))}
                </div>
            </div>
        </div>
    </div>
    
    <div class="about-content-card card-enter">
        <div class="content-header">
            <h2 class="header-title">关于我</h2>
        </div>
        <div class="content-body">
            <Markdown class="mt-2">
                <Content />
            </Markdown>
        </div>
    </div>
    
    <div class="mobile-friends-card md:hidden">
        <h3 class="card-title text-accent">友链</h3>
        <FriendsList class="friends-list" />
    </div>
    
    <div slot="sidebar" class="hidden md:block space-y-6">
        <div class="desktop-friend-info-card">
            <h3 class="sidebar-title text-accent">我的友链</h3>
            <div class="friend-info-content">
                <div class="friend-info-item">
                    <span class="info-label text-muted">站点名称：</span>
                    <span class="info-value text-accent">mikann_OMO</span>
                </div>
                <div class="friend-info-item">
                    <span class="info-label text-muted">站点地址：</span>
                    <span class="info-value text-accent">https://www.mikann.fun</span>
                </div>
                <div class="friend-info-item">
                    <span class="info-label text-muted">站点头像：</span>
                    <span class="info-value truncate text-accent">https://mikann.fun/avatar.webp</span>
                </div>
                <div class="friend-info-item">
                    <span class="info-label text-muted">站点描述：</span>
                    <span class="info-value text-accent">是一位超级无敌可爱美少女</span>
                </div>
                <button class="copy-friend-btn" type="button">
                    一键复制
                </button>
            </div>
        </div>
        
        <div class="desktop-friends-card">
            <h3 class="sidebar-title text-accent">友链</h3>
            <FriendsList class="space-y-2" />
        </div>
    </div>
    
    <script>
        const friendLink = `const items = [ 
     { 
         title: "mikann_OMO", 
         image: 
              "https://mikann.fun/avatar.webp", 
         desc: "是一位超级无敌可爱美少女", 
         siteurl: "https://www.mikann.fun", 
         tags: [""], 
     }`;

        function setButtonState(button: HTMLButtonElement, text: string, bg: string) {
            button.textContent = text;
            button.style.background = bg;
            button.style.color = "white";
        }

        async function copyFriendLink(button: HTMLButtonElement) {
            const originalText = button.textContent || "一键复制";
            setButtonState(button, "复制中...", "var(--primary)");
            try {
                if (navigator.clipboard && window.isSecureContext) {
                    try {
                        await navigator.clipboard.writeText(friendLink);
                        setButtonState(button, "已成功复制！", "#4CAF50");
                    } catch (_err) {
                        window.prompt("复制下面内容", friendLink);
                        setButtonState(button, "已打开复制框", "#4CAF50");
                    }
                } else {
                    window.prompt("复制下面内容", friendLink);
                    setButtonState(button, "已打开复制框", "#4CAF50");
                }
            } catch (_err) {
                setButtonState(button, "复制失败", "#f44336");
            } finally {
                setTimeout(() => {
                    button.textContent = originalText;
                    button.style.background = "";
                    button.style.color = "";
                }, 2000);
            }
        }

        function setupCopyButton() {
            const button = document.querySelector<HTMLButtonElement>(".copy-friend-btn");
            if (!button) return;
            button.addEventListener("click", () => copyFriendLink(button));
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", setupCopyButton);
        } else {
            setupCopyButton();
        }

        document.addEventListener("astro:page-load", setupCopyButton);
    </script>
</MainGridLayout>

<style>

.mobile-friends-card {
    background: var(--tint-10);
    border-radius: 0;
    padding: 16px;
    box-shadow: 0 2px 12px var(--shadow-color);
    border: 1px solid var(--card-border);
}

.card-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--accent-text);
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--card-border);
}

.about-content-card {
    background: color-mix(in srgb, var(--card-bg) 88%, transparent);
    border-radius: 0;
    overflow: hidden;
    box-shadow: 0 4px 24px var(--shadow-color);
    border: 1px solid color-mix(in srgb, var(--card-border) 60%, transparent);
}

.content-header {
    background: color-mix(in srgb, var(--card-bg) 88%, transparent);
    padding: 12px 16px;
    border-left: 4px solid var(--accent-text);
}

.header-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--accent-text);
}

.content-body {
    padding: 16px;
}

.desktop-friend-info-card,
.desktop-friends-card {
    background: var(--tint-10);
    border-radius: 0;
    padding: 16px;
    box-shadow: 0 4px 20px var(--shadow-color);
    border: none;
}

.friend-info-content {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.friend-info-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.info-label {
    font-size: 0.875rem;
    font-weight: 400;
    color: color-mix(in srgb, var(--text-primary) 50%, transparent);
}

.info-value {
    font-size: 0.8125rem;
    color: var(--accent-text);
    word-break: break-all;
    white-space: normal;
}

.truncate {
    overflow: visible;
    text-overflow: clip;
    white-space: normal;
    word-break: break-all;
}

.copy-friend-btn {
    margin-top: 8px;
    padding: 6px 12px;
    background: var(--card-bg);
    color: var(--accent-text);
    border: 1px solid color-mix(in srgb, var(--primary) 30%, transparent);
    border-radius: 0;
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 1px 3px color-mix(in srgb, var(--primary) 10%, transparent);
}

.copy-friend-btn:hover {
    background: var(--card-bg);
    border-color: color-mix(in srgb, var(--primary) 40%, transparent);
    box-shadow: 0 2px 6px color-mix(in srgb, var(--primary) 15%, transparent);
    transform: translateY(-1px);
}

.copy-friend-btn:active {
    transform: translateY(0);
    background: var(--card-bg);
    box-shadow: 0 1px 2px color-mix(in srgb, var(--primary) 10%, transparent);
}

.sidebar-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--accent-text);
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--card-border);
}

@media (max-width: 768px) {
    .mobile-friends-card :global(.friends-list) {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }
    
    .mobile-friends-card :global(a) {
        padding: 8px 12px;
        border-radius: 0;
        font-size: 0.8125rem;
    }
}
</style>
