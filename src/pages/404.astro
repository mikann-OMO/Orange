---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";

export const prerender = true;
---

<MainGridLayout 
	title={i18n(I18nKey.pageNotFound)} 
	description={i18n(I18nKey.notFound)}
	fullWidth={true}
	centerContent={true}
	showAnnouncement={false}
>
	<div class="flex flex-col items-center justify-center min-h-[60vh] text-center px-4">
		<h1 class="text-6xl font-bold text-[var(--text-primary)] mb-4">404</h1>
		<p class="text-xl text-[var(--text-secondary)] mb-2">{i18n(I18nKey.pageNotFound)}</p>
		<p class="text-[var(--text-secondary)] mb-8">{i18n(I18nKey.notFound)}</p>
		<a href="/" class="btn-solid px-6 py-3 rounded-lg">
			{i18n(I18nKey.backHome)}
		</a>
	</div>
</MainGridLayout>