---
import Footer from "@components/Footer.astro";
import Navbar from "@components/Navbar.astro";

import type { MarkdownHeading } from "astro";
import MobileTocDrawer from "@components/control/MobileTocDrawer.astro";
import AnnouncementCard from "@components/widget/AnnouncementCard.astro";
import SidebarToc from "@components/widget/SidebarToc.astro";
import { siteConfig } from "@/config";
import Layout from "@layouts/Layout.astro";

import announcement from "@/content/announcement.yaml";

interface AnnouncementConfig {
	title: string;
	content: string;
	avatar: string;
	enabled: boolean;
}

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	headings?: MarkdownHeading[];
	fullWidth?: boolean;
	centerContent?: boolean;
	showAnnouncement?: boolean;
	isPostPage?: boolean;
	announcementConfig?: AnnouncementConfig;
	image?: string;
	keywords?: string[];
	published?: Date;
	updated?: Date;
	tags?: string[];
}

const {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	headings = [],
	fullWidth = false,
	centerContent = false,
	showAnnouncement = true,
	isPostPage = false,
	announcementConfig,
	image,
	keywords,
	published,
	updated,
	tags,
} = Astro.props;

const activeAnnouncement: AnnouncementConfig = (announcementConfig || announcement) as AnnouncementConfig;

const contentColClass = fullWidth
	? "md:col-span-12 lg:col-span-12"
	: centerContent
		? "md:col-span-10 lg:col-span-10 md:col-start-2 lg:col-start-2"
		: "md:col-span-8 lg:col-span-8";
---

<Layout 
	title={title} 
	banner={banner} 
	description={description} 
	lang={lang} 
	setOGTypeArticle={setOGTypeArticle}
	image={image}
	keywords={keywords}
	published={published}
	updated={updated}
	tags={tags}
>

<slot slot="head" name="head"></slot>

<div id="top-row" class="z-[999] pointer-events-none fixed top-0 left-0 right-0 w-full" transition:persist>
	<div id="reading-progress" class="fixed top-0 left-0 right-0 h-[2px] bg-[var(--primary)] z-[1000] transform-origin-left scale-x-0 transition-transform duration-150"></div>
	<div id="navbar-wrapper" class="pointer-events-auto fixed top-0 left-0 right-0 w-full shadow-md z-[999] bg-[color-mix(in_srgb,var(--card-bg)_92%,transparent)]">
		<Navbar></Navbar>
	</div>
</div>

{siteConfig.banner.enable && (
	<div id="banner-wrapper" class="h-dvh w-full fixed top-0 left-0 right-0 z-0 hidden md:block" transition:persist>
		<img
			id="banner-light-img"
			src="/images/dog.jpg"
			alt=""
			loading="eager"
			decoding="async"
			fetchpriority="high"
			class="banner-img"
			style="background-color:#fbf9ec;"
		/>
		<img
			id="banner-dark-img"
			src="/images/ccc.jpg"
			alt=""
			loading="lazy"
			decoding="async"
			fetchpriority="low"
			class="banner-img banner-img-hidden"
			style="background-color:#0f0f12;"
		/>
	</div>
)}

<script is:inline define:vars={{enable: siteConfig.banner.enable}}>
	if (enable) {
		function syncBannerTheme() {
			var isDark = document.documentElement.classList.contains('dark');
			var lightEl = document.getElementById('banner-light-img');
			var darkEl = document.getElementById('banner-dark-img');
			if (lightEl) lightEl.classList.toggle('banner-img-hidden', isDark);
			if (darkEl) darkEl.classList.toggle('banner-img-hidden', !isDark);
		}

		// 图片加载后淡入，避免空白闪烁
		document.querySelectorAll('.banner-img').forEach(function (img) {
			if (img.complete && img.naturalWidth > 0) {
				img.classList.add('banner-img-loaded');
			} else {
				img.addEventListener('load', function () {
					img.classList.add('banner-img-loaded');
				}, { once: true });
			}
		});

		syncBannerTheme();

		if (!window.__bannerThemeInstalled) {
			window.__bannerThemeInstalled = true;
			window.addEventListener('themeChange', syncBannerTheme);
		}
	}
</script>

<div id="main-wrapper" class="relative w-full z-10 min-h-screen min-h-full">
	<div class:list={[
		"absolute top-0 z-[-1] rounded-none shadow-xl pointer-events-none",
		isPostPage ? "glass-surface-post" : "glass-surface"
	]} style="left: 50%; transform: translateX(-50%); transform-origin: center center; max-width: var(--page-width); width: 100%; height: 100%; min-height: 100vh;"></div>

	<div id="content-wrapper" class="relative max-w-[var(--page-width)] mx-auto min-h-full overflow-x-clip">
		<div id="main-grid" class="w-full gap-4 md:gap-6 px-3 md:px-6 grid grid-cols-1 md:grid-cols-12 grid-rows-[auto_auto_auto] max-w-[var(--page-width)] items-start">
			{isPostPage ? (
				<>
					<main id="content-container" class="md:col-span-8 lg:col-span-8">
						<div class="w-full">
							<slot></slot>
						</div>
					</main>
					<aside class="md:col-span-4 lg:col-span-4 pt-0 mt-0 relative self-stretch space-y-4">
						{activeAnnouncement.enabled && showAnnouncement && (
							<AnnouncementCard
								title={activeAnnouncement.title}
								content={activeAnnouncement.content}
								avatar={activeAnnouncement.avatar}
							/>
						)}

						<slot name="like"></slot>

						{headings.length > 0 && (
							<div class="sticky top-24">
								<SidebarToc headings={headings} />
							</div>
						)}

						<div class="mt-4">
							<slot name="sidebar"></slot>
						</div>
					</aside>
				</>
			) : (
				<>
					<main id="content-container" class={contentColClass}>
						<div class="w-full">
							<slot></slot>
						</div>
					</main>

					{!fullWidth && (
						<aside class="md:col-span-4 lg:col-span-4 pt-0 mt-0 relative self-start">
							{activeAnnouncement.enabled && showAnnouncement && (
								<AnnouncementCard
									title={activeAnnouncement.title}
									content={activeAnnouncement.content}
									avatar={activeAnnouncement.avatar}
								/>
							)}

							<div class="mt-6">
								<slot name="sidebar"></slot>
							</div>
						</aside>
					)}
				</>
			)}
		</div>
		<Footer></Footer>
	</div>
</div>

{isPostPage && headings.length > 0 && (
	<MobileTocDrawer headings={headings} />
)}

</Layout>

<script src="../scripts/reading-progress.ts"></script>

<style>
#main-wrapper {
	position: relative;
	width: 100%;
	z-index: 10;
	min-height: 100vh;
	min-height: 100dvh;
}

/* ===== 背景大图优化：img + object-fit，加载后淡入 ===== */
.banner-img {
	position: absolute;
	inset: 0;
	width: 100%;
	height: 100%;
	object-fit: cover;
	object-position: center;
	opacity: 0;
	transition: opacity 0.6s ease;
	pointer-events: none;
	user-select: none;
	-webkit-user-drag: none;
}

.banner-img.banner-img-loaded {
	opacity: 1;
}

.banner-img.banner-img-hidden {
	display: none;
}

#content-wrapper {
	position: relative;
	max-width: var(--page-width);
	margin: 0 auto;
	min-height: 100%;
	overflow-x: clip;
}

#main-grid {
	width: 100%;
	left: 0;
	right: 0;
	margin: 0 auto;
	max-width: var(--page-width);
}

#content-container {
	width: 100%;
}

@media (max-width: 768px) {
	#content-wrapper {
		padding-top: 52px;
	}

	#main-grid {
		gap: 0;
		padding: 12px 0 0;
	}

	#content-container {
		padding: 12px;
		background: transparent;
	}

	aside {
		display: none;
	}

	.footer {
		padding: 16px 12px;
		background: transparent;
	}

	#top-row {
		position: fixed;
	}

	#navbar-wrapper {
		background: color-mix(in srgb, var(--card-bg) 92%, transparent);
		box-shadow: 0 1px 8px var(--shadow-color), 0 0 0 1px var(--card-border);
	}
	
	:global(.dark) #navbar-wrapper {
		background: color-mix(in srgb, var(--card-bg) 95%, transparent);
		box-shadow: 0 1px 8px var(--shadow-color), 0 0 0 1px var(--card-border);
	}
}

@media (min-width: 769px) {
	#content-wrapper {
		padding-top: 1rem;
	}

	#main-grid {
		padding-top: 0;
	}
}
</style>
